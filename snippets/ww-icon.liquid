{%- comment -%}
  Wunderwell icon set.
  Usage: {% render 'ww-icon', icon: 'check-circle' %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'check-circle' -%}
    <svg class="ww-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="12" fill="currentColor"/><path d="M7 12.4l3.2 3.1L17.2 8.6" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'check' -%}
