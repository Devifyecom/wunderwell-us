{% render 'ww-assets' %}

{%- liquid
  assign old_rows = section.settings.old_rows | newline_to_br | split: '<br />'
  assign new_rows = section.settings.new_rows | newline_to_br | split: '<br />'
-%}

<div class="ww-section ww-compare">
  <div class="ww-container">
    <div class="ww-head-center">
      {%- if section.settings.eyebrow != blank -%}<p class="ww-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ww-heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="ww-compare__card">
      <div class="ww-compare__cols">
        <div class="ww-compare__col">
          <h3>{{ section.settings.old_title }}</h3>
          {%- for row in old_rows -%}
            {%- assign row = row | strip -%}
            {%- if row != blank -%}
              {%- assign cells = row | split: '|' -%}
              <div class="ww-compare__row"><span>{{ cells[0] | strip }}</span><b>{{ cells[1] | strip }}</b></div>
            {%- endif -%}
          {%- endfor -%}
          <div class="ww-compare__total"><span>{{ section.settings.total_label }}</span><span>{{ section.settings.old_total }}</span></div>
        </div>

        <div class="ww-compare__col ww-compare__col--us">
          <h3>{{ section.settings.new_title }}</h3>
          {%- for row in new_rows -%}
            {%- assign row = row | strip -%}
            {%- if row != blank -%}
              {%- assign cells = row | split: '|' -%}
              <div class="ww-compare__row"><span>{{ cells[0] | strip }}</span><b>{{ cells[1] | strip }}</b></div>
            {%- endif -%}
          {%- endfor -%}
          <div class="ww-compare__total"><span>{{ section.settings.total_label }}</span><span>{{ section.settings.new_total }}</span></div>
        </div>
      </div>

      {%- if section.settings.save_amount != blank -%}
        <p class="ww-compare__save">
          {{ section.settings.save_before }} <b>{{ section.settings.save_amount }}</b> {{ section.settings.save_after }}
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WW Comparison",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The smart way to feel better" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One bottle of Hey Girl replaces..." },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Monthly" },
    { "type": "header", "content": "Left column" },
    { "type": "text", "id": "old_title", "label": "Title", "default": "The old way" },
    {
      "type": "textarea",
      "id": "old_rows",
      "label": "Rows",
      "info": "One per line: Item | Price",
      "default": "Urgent care visit | $150\nAntibiotic course | $35\nCranberry pills & gummies | $30\nAZO & pain relief | $20\nUTI test strips | $18\nPost-antibiotic probiotics | $25"
    },
    { "type": "text", "id": "old_total", "label": "Total", "default": "$278" },
    { "type": "header", "content": "Right column" },
    { "type": "text", "id": "new_title", "label": "Title", "default": "The Hey Girl way" },
    {
      "type": "textarea",
      "id": "new_rows",
      "label": "Rows",
      "info": "One per line: Item | Price",
      "default": "Hey Girl Subscribe & Save | $28.90\nFree Tea Tumbler | FREE\n30-Day Guarantee | FREE\nFree Shipping | FREE"
    },
    { "type": "text", "id": "new_total", "label": "Total", "default": "$28.90" },
    { "type": "header", "content": "Savings line" },
    { "type": "text", "id": "save_before", "label": "Text before", "default": "Save" },
    { "type": "text", "id": "save_amount", "label": "Amount", "default": "$2,990" },
    { "type": "text", "id": "save_after", "label": "Text after", "default": "per year" }
  ],
  "presets": [{ "name": "WW Comparison" }]
}
{% endschema %}
