{% render 'ww-assets' %}

<div class="ww-section ww-ingredients">
  <div class="ww-container">
    <div class="ww-head-center">
      {%- if section.settings.eyebrow != blank -%}<p class="ww-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ww-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="ww-sub ww-rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="ww-ingredients__grid">
      {%- for block in section.blocks -%}
        <div class="ww-ing" {{ block.shopify_attributes }}>
          <div class="ww-ing__img">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '300, 450, 600', alt: block.settings.name
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <h3>{{ block.settings.name }}</h3>
          <p class="ww-ing__dose">{{ block.settings.dose }}</p>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.difference != blank -%}
      <div class="ww-diff ww-rte">{{ section.settings.difference }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="ww-btn-wrap">
        <a class="ww-btn" href="{{ section.settings.button_link | default: '#ww-buy' }}">
          {{ section.settings.button_label }}
          {% render 'ww-icon', icon: 'arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "WW Ingredients",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two Capsules. Total Bladder Support." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Hey Girl D-Mannose isn't another cranberry pill that does nothing. It's natural actives that flush, soothe, and support your urinary tract at once.</p>"
    },
    {
      "type": "richtext",
      "id": "difference",
      "label": "Difference box",
      "default": "<p><strong>The difference:</strong> most cranberry pills are underdosed and stop at one ingredient. Hey Girl leads with a real 1,000mg of D-Mannose, then layers in Cranberry, Hibiscus, and Dandelion. You get the flush <em>and</em> the daily support, not a token dose.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start flushing" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#ww-buy" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "D-Mannose" },
        { "type": "text", "id": "dose", "label": "Dose", "default": "1,000MG" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Keeps UTI-causing bacteria from sticking to your bladder wall, so your body flushes it out." }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW Ingredients",
      "blocks": [
        { "type": "ingredient" },
        { "type": "ingredient", "settings": { "name": "Cranberry Extract", "dose": "250MG", "text": "Concentrated cranberry without the juice sugar. Its PACs support a healthy urinary tract." } },
        { "type": "ingredient", "settings": { "name": "Hibiscus", "dose": "75MG", "text": "Traditionally used for urinary and kidney support, it helps calm an irritated bladder." } },
        { "type": "ingredient", "settings": { "name": "Dandelion", "dose": "75MG", "text": "A gentle natural diuretic that supports your kidneys and the daily flushing that keeps bacteria out." } }
      ]
    }
  ]
}
{% endschema %}
