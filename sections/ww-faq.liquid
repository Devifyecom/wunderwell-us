{% render 'ww-assets' %}

<div class="ww-section ww-faq">
  <div class="ww-container">
    <div class="ww-head-center">
      {%- if section.settings.eyebrow != blank -%}<p class="ww-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ww-heading">{{ section.settings.heading }}</h2>
    </div>
    <div class="ww-faq__list">
      {%- for block in section.blocks -%}
        <details class="ww-faq__item" {{ block.shopify_attributes }}>
          <summary>
            {{ block.settings.question }}
            <span class="ww-faq__plus">{% render 'ww-icon', icon: 'plus' %}</span>
          </summary>
          <div class="ww-faq__answer ww-rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "WW FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Frequently asked" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quick answers." },
    { "type": "checkbox", "id": "schema_markup", "label": "Add FAQ structured data", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How fast does it work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most women feel the burning and urgency ease within 24 to 48 hours.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "WW FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
