{% render 'ww-assets' %}

<div class="ww-section ww-circle">
  <div class="ww-container ww-circle__grid">
    <div class="ww-circle__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1100
          | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 520px, 100vw', widths: '520, 800, 1100', alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'product-4' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="ww-circle__disc">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ww-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="ww-rte">{{ section.settings.text }}</div>
      {%- if section.blocks.size > 0 -%}
        <ul class="ww-circle__list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'ww-icon', icon: 'check' %} {{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WW Benefit circle",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Capsule image with benefit callouts" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One blend. Support from every angle." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Most cranberry pills stop at one job. Hey Girl D-Mannose works across your whole urinary tract at once, so you get real support right where you feel it.</p>"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Check item",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Flushes the bacteria behind UTIs" }]
    }
  ],
  "presets": [
    {
      "name": "WW Benefit circle",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "text": "Soothes an irritated bladder" } },
        { "type": "item", "settings": { "text": "Eases that constant urge to go" } },
        { "type": "item", "settings": { "text": "Supports your kidneys" } },
        { "type": "item", "settings": { "text": "Calms the burning" } }
      ]
    }
  ]
}
{% endschema %}
