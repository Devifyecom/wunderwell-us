{% render 'ww-assets' %}

<div class="ww-section ww-btiles">
  <div class="ww-container">
    <div class="ww-btiles__wrap">
      {%- for block in section.blocks -%}
        <div class="ww-btiles__group" {{ block.shopify_attributes }}>
          <div class="ww-btiles__img">
            {%- if block.settings.chip != blank -%}
              <span class="ww-btiles__chip">{% render 'ww-icon', icon: 'crown' %} {{ block.settings.chip }}</span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 360px, 60vw', widths: '400, 700, 900', alt: block.settings.image.alt
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="ww-btiles__col">
            {%- for i in (1..3) -%}
              {%- liquid
                assign icon_key = 'icon_' | append: i
                assign image_key = 'icon_image_' | append: i
                assign text_key = 'text_' | append: i
              -%}
              {%- if block.settings[text_key] != blank -%}
                <div class="ww-btile">
                  {%- if block.settings[image_key] != blank -%}
                    {{ block.settings[image_key] | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {% render 'ww-icon', icon: block.settings[icon_key] %}
                  {%- endif -%}
                  <span>{{ block.settings[text_key] }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WW Benefit tiles",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "group",
      "name": "Image + tiles",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "chip", "label": "Image chip", "default": "Bestseller" },
        {
          "type": "select", "id": "icon_1", "label": "Tile 1 icon", "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" }, { "value": "bladder", "label": "Bladder" }, { "value": "blocked", "label": "Blocked bacteria" },
            { "value": "drops", "label": "Drops" }, { "value": "bacteria", "label": "Bacteria" }, { "value": "kidney", "label": "Kidney" }, { "value": "leaf", "label": "Leaf" }
          ]
        },
        { "type": "image_picker", "id": "icon_image_1", "label": "Tile 1 custom icon" },
        { "type": "text", "id": "text_1", "label": "Tile 1 text", "default": "Prevents Recurrent UTIs" },
        {
          "type": "select", "id": "icon_2", "label": "Tile 2 icon", "default": "bladder",
          "options": [
            { "value": "shield", "label": "Shield" }, { "value": "bladder", "label": "Bladder" }, { "value": "blocked", "label": "Blocked bacteria" },
            { "value": "drops", "label": "Drops" }, { "value": "bacteria", "label": "Bacteria" }, { "value": "kidney", "label": "Kidney" }, { "value": "leaf", "label": "Leaf" }
          ]
        },
        { "type": "image_picker", "id": "icon_image_2", "label": "Tile 2 custom icon" },
        { "type": "text", "id": "text_2", "label": "Tile 2 text", "default": "Reduces Bladder Irritation" },
        {
          "type": "select", "id": "icon_3", "label": "Tile 3 icon", "default": "blocked",
          "options": [
            { "value": "shield", "label": "Shield" }, { "value": "bladder", "label": "Bladder" }, { "value": "blocked", "label": "Blocked bacteria" },
            { "value": "drops", "label": "Drops" }, { "value": "bacteria", "label": "Bacteria" }, { "value": "kidney", "label": "Kidney" }, { "value": "leaf", "label": "Leaf" }
          ]
        },
        { "type": "image_picker", "id": "icon_image_3", "label": "Tile 3 custom icon" },
        { "type": "text", "id": "text_3", "label": "Tile 3 text", "default": "Blocks Bacteria Naturally" }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW Benefit tiles",
      "blocks": [
        { "type": "group" },
        {
          "type": "group",
          "settings": {
            "icon_1": "drops", "text_1": "Reduces Urinary Frequency",
            "icon_2": "bacteria", "text_2": "Prevents Bacterial Overgrowth",
            "icon_3": "bladder", "text_3": "Supports bladder comfort"
          }
        }
      ]
    }
  ]
}
{% endschema %}
