{% render 'ww-assets' %}

<div class="ww-section ww-problem">
  <div class="ww-container ww-problem__grid">
    <div class="ww-problem__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ww-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="ww-heading">
        {{- section.settings.heading -}}
        {%- if section.settings.accent != blank %} <span class="ww-accent">{{ section.settings.accent }}</span>{% endif -%}
      </h2>
      <div class="ww-rte">{{ section.settings.text }}</div>

      {%- if section.blocks.size > 0 -%}
        <div class="ww-stats-mini">
          {%- for block in section.blocks -%}
            <div class="ww-stat-mini" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.value }}</strong>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ww-problem__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200', alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WW Problem + stats",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You are not imagining it. You're not alone." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "If UTIs run your life." },
    { "type": "text", "id": "accent", "label": "Accent heading", "default": "They don't have to." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The burning. The constant urge with nothing there. The dread after intimacy. The 2 a.m. trips and the fear of the next flare. It is exhausting, and it is not in your head.</p><p>Most women reach for cranberry pills or wait it out. There is a faster, cleaner way to flush and stay ahead of it.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "1 in 2" },
        { "type": "text", "id": "label", "label": "Label", "default": "women will have a UTI in their lifetime" }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW Problem + stats",
      "blocks": [
        { "type": "stat" },
        { "type": "stat", "settings": { "value": "1 in 4", "label": "deal with repeat UTIs within 6 months" } }
      ]
    }
  ]
}
{% endschema %}
