{% render 'ww-assets' %}

<div class="ww-section ww-callout">
  <div class="ww-container">
    {%- if section.settings.show_box -%}
      <div class="ww-callout__box">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ww-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <div class="ww-rte">{{ section.settings.text }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="ww-callout__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="ww-btn-wrap">
        <a class="ww-btn" href="{{ section.settings.button_link | default: '#ww-buy' }}">
          {{ section.settings.button_label }}
          {% render 'ww-icon', icon: 'arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "WW Callout + button",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_box", "label": "Show pink box", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "That's why we created Hey Girl D-Mannose" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A natural sugar studied to flush the bacteria behind UTIs, paired with Cranberry, Hibiscus, and Dandelion to soothe the bladder and support your kidneys. Ingredients that work with your body, not against it.</p>"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Flush it. Stay ahead of it." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start flushing" },
    { "type": "text", "id": "button_link", "label": "Button link", "info": "Leave blank to scroll to the purchase box", "default": "#ww-buy" }
  ],
  "presets": [{ "name": "WW Callout + button" }]
}
{% endschema %}
